# An openSUSE Leap MICROVM WITH NO DESKTOP: KERNEL, INITRAMFS, ROOT FILESYSTEM, SERIAL LOGIN.
#
# THE SAME SHAPE AS THE ALPINE, DEBIAN AND NIXOS MICROVMS: a kernel, an initramfs, and ONE FLAT ext4
# qcow2 with no partition table, booted with `-kernel` because a microvm has no firmware to read a
# boot sector.
# MEASURED: SUSE'S KERNEL IS THE ONE THAT NEEDS THE MOST MODULES - `CONFIG_VIRTIO_BLK=m` AND
# `CONFIG_EXT4_FS=m`, with ext4 depending on jbd2 and mbcache and jbd2 on crc16. The initramfs loads
# six in dependency order; see `.github/leap-rootfs.sh` for the measurement.
# NOTHING HERE INSTALLS openSUSE Leap. `.github/leap-rootfs.sh` builds the three files; this walkthrough
# boots them and reads the console.
#
# THE ASSERTION IS THE SERIAL LINE, NOT A SCREEN. There is no framebuffer on this machine - a GPU
# needs PCIe, and `pcie=off` means there is none - so the recording is the "NO DISPLAY" card the
# recorder draws while a guest has no adapter.
walkthrough "opensuse microvm - a root filesystem, a serial login, and no PCIe"
resolution 1024x768
recording_resolution 1024x768
# THE THREE FILES THE CI STEP BUILDS, named here so the boot step can refer to them.
step "needs leap-vmlinuz leap-initramfs leap.qcow2"
  needs [leap-vmlinuz, leap-initramfs, leap.qcow2]
# THE ROOT FILESYSTEM, BUILT BY THE CI STEP AND NOT INSTALLED BY THIS FILE.


step "disk leap.qcow2"
  disk leap.qcow2
# `without a display` AND NOT `with a console`: this guest has no VGA adapter at all, which is the
# honest shape for a machine with no PCIe.
#
# `rootfstype=ext4` IS NAMED BECAUSE THE INITRAMFS NEEDS TO AGREE WITH THE IMAGE. `console=ttyS0`
# is the only place this guest can be read.


step "boot as a microvm from kernel \"leap-vmlinuz\" and initramfs \"leap-initramfs\" with \"console=ttyS0 root=/dev/vda rw rootfstype=ext4\" without a display with memory 1024, waiting up to 180s"
  boot
    machine "microvm,accel=kvm,acpi=on,pic=on,rtc=on,pcie=off,graphics=off"
    args [["-m", "1024"], ["-chardev", "socket,id=qga0,path={{work}}/qga.sock,server=on,wait=off"], ["-device", "isa-serial,chardev=qga0"], ["-drive", "file={{disk}},if=none,format=qcow2,id=target{{discard}}"], ["-device", "virtio-blk-device,drive=target"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-device,netdev=net0,mac=52:54:00:56:4d:01"], ["-kernel", "{{work}}/leap-vmlinuz"], ["-initrd", "{{work}}/leap-initramfs"], ["-append", "console=ttyS0 root=/dev/vda rw rootfstype=ext4"]]
    kernel leap-vmlinuz
    initrd leap-initramfs
    kernel_append "console=ttyS0 root=/dev/vda rw rootfstype=ext4"
    timeout 180
# THE FIRST FACT: the kernel found the disk. Without `acpi=on` this never appears, and the guest
# reaches `ALERT! /dev/vda does not exist` or a `VFS: Cannot open root device` panic instead.


step "the console will say \"vda\""
  until vda
  from console
  timeout 180
# THE SECOND: init finished and a login is waiting.


step "the console will say \"login\""
  until login
  from console
  timeout 180
# TWENTY SECONDS OF A GUEST AT A PROMPT, so the recording is a machine that stayed up.


step "wait 20s"
  settle 20


step "stop the machine by killing it, waiting up to 60s"
  stop kill
  timeout 60
