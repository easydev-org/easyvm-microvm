# AN ARCH LINUX MICROVM RUNNING XFCE ON AN X SERVER IN MEMORY.
#
# THE SAME SHAPE AS THE SWAY VARIANT, WITH ONE STRUCTURAL DIFFERENCE: THIS IS X11, SO THE
# DISPLAY SERVER IS `Xvfb` AND THE CAPTURE PATH IS XSHM RATHER THAN wlr-screencopy.
#
# WHY AN X SERVER AT ALL, AND WHY THAT ONE. A microvm has no GPU and, without vkms, no DRM
# node; Xorg's `modesetting` driver has nothing to open. `Xvfb` needs neither - it renders
# into its own process memory - which is why the whole X11 family works on a machine that
# cannot run Xorg. MEASURED: XFCE's session manager draws a panel, a desktop with Home and File System icons, and a dock.
#
# EVERY X11 DESKTOP NEEDS A SESSION BUS, and this image gives it one: `dbus-run-session`
# wraps the session manager. MEASURED on XFCE before that line existed, the desktop started
# and drew "Unable to contact settings server / Could not connect", which is what a desktop
# without a bus looks like.
#
# The assertion is the panel's own text, which only a running xfce4-panel paints.
walkthrough "xfce microvm - XFCE on xvfb, captured over xshm"
resolution 1024x768
recording_resolution 1024x768
step "needs arch-vmlinuz arch-initramfs arch.qcow2"
  needs [arch-vmlinuz, arch-initramfs, arch.qcow2]


step "disk arch.qcow2"
  disk arch.qcow2


step "boot as a microvm from kernel \"arch-vmlinuz\" and initramfs \"arch-initramfs\" with \"console=ttyS0 root=/dev/vda rw rootfstype=ext4\" without a display with memory 1536, waiting up to 240s"
  boot
  initrd arch-initramfs
  kernel arch-vmlinuz
  kernel_append "console=ttyS0 root=/dev/vda rw rootfstype=ext4"
  memory_mb 1536
  microvm
  microvm_display serial
  os microvm
  timeout 240
# THE CONSOLE REACHES A LOGIN, which is the boot working.


step "the console will say \"login\""
  until login
  from console
  timeout 180
# AND THE SESSION IS vmuser's - PipeWire refuses root (`ConditionUser=!root`) and every
# desktop here goes through it for audio.


step "the console will say \"vmuser\""
  until vmuser
  from console
  timeout 180
# THE SESSION MANAGER ITSELF. A desktop that could not start leaves the console quiet;
# this line is the manager's own name, printed once it is running.


step "the console will say \"xfce4-session\""
  until xfce4-session
  from console
  timeout 180


step "wait 20s"
  settle 20


step "stop the machine by killing it, waiting up to 60s"
  stop kill
  timeout 60
